Options -MultiViews
RewriteEngine On

# One canonical host: https://pamangan.com (no www, always https)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Sitemap and private files
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^seo-data\.json$ - [F]
RewriteRule ^\.seo-cache(/|$) - [F]

# App routes -> React app, served by seo.php with page-specific meta and status codes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ seo.php [QSA,L]

<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

<IfModule LiteSpeed>
  CacheLookup off
  RewriteRule index\.html$ - [E=cache-control:no-cache]
</IfModule>
