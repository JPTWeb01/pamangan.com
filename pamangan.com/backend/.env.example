MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pamangan
DB_NAME=pamangan
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Optional: override AI models if a provider retires one
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
SECRET_KEY=replace-with-a-64-character-random-string
DEBUG=False
FLASK_ENV=production
PORT=5000
CORS_ORIGINS=http://localhost:3000,https://pamangan.com

# Google Analytics 4 (admin Analytics tab). Paste the full service-account JSON key as an HF secret.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
